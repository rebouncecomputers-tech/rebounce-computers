// Rebounce Computers — E-commerce Rebuild
// Database schema: MySQL + Prisma

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---------- USERS & AUTH ----------

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  phone         String?   @unique
  passwordHash  String?
  firstName     String?
  lastName      String?
  role          Role      @default(CUSTOMER)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  addresses     Address[]
  orders        Order[]
  wishlist      WishlistItem[]
  compareItems  CompareItem[]
  reviews       Review[]
  cart          Cart?

  @@index([email])
  @@index([phone])
}

enum Role {
  CUSTOMER
  ADMIN
  STAFF
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String?
  firstName   String
  lastName    String
  street      String
  apartment   String?
  city        String
  county      String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  orders      Order[]

  @@index([userId])
}

// ---------- CATALOG ----------

model Category {
  id           String     @id @default(cuid())
  name         String
  slug         String     @unique
  description  String?    @db.Text
  imageUrl     String?
  parentId     String?
  parent       Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[] @relation("CategoryTree")
  displayOrder Int        @default(0)
  isActive     Boolean    @default(true)

  products     Product[]

  @@index([parentId])
  @@index([slug])
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  logoUrl  String?
  products Product[]
}

model Product {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  description      String    @db.Text
  shortDescription String?   @db.VarChar(500)

  categoryId       String
  category         Category  @relation(fields: [categoryId], references: [id])
  brandId          String?
  brand            Brand?    @relation(fields: [brandId], references: [id])

  basePrice        Decimal   @db.Decimal(10, 2)
  compareAtPrice   Decimal?  @db.Decimal(10, 2)
  sku              String    @unique

  condition        Condition @default(NEW)
  warrantyMonths   Int       @default(12)

  isActive         Boolean   @default(true)
  isFeatured       Boolean   @default(false)
  publishedAt      DateTime?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  images           ProductImage[]
  variants         ProductVariant[]
  specs            ProductSpec[]
  reviews          Review[]
  orderItems       OrderItem[]
  wishlistedBy     WishlistItem[]
  comparedBy       CompareItem[]
  cartItems        CartItem[]
  deals            DealProduct[]

  @@index([categoryId])
  @@index([brandId])
  @@index([isFeatured])
  @@fulltext([name, description])
}

enum Condition {
  NEW
  REFURBISHED
  USED
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  @@index([productId])
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  sku        String   @unique
  priceDelta Decimal  @default(0) @db.Decimal(10, 2)
  stockQty   Int      @default(0)
  isDefault  Boolean  @default(false)

  orderItems OrderItem[]
  cartItems  CartItem[]

  @@index([productId])
}

model ProductSpec {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  value     String
  sortOrder Int     @default(0)

  @@index([productId])
}

// ---------- DEALS / MERCHANDISING ----------

model Deal {
  id        String        @id @default(cuid())
  title     String
  slug      String        @unique
  bannerUrl String?
  startsAt  DateTime?
  endsAt    DateTime?
  isActive  Boolean       @default(true)

  products  DealProduct[]

}

model DealProduct {
  dealId    String
  deal      Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([dealId, productId])
}

// ---------- CART / WISHLIST / COMPARE ----------

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int             @default(1)

  @@index([cartId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  addedAt   DateTime @default(now())

  @@unique([userId, productId])
}

model CompareItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  addedAt   DateTime @default(now())

  @@unique([userId, productId])
}

// ---------- ORDERS ----------

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  addressId     String
  address       Address       @relation(fields: [addressId], references: [id])

  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)
  paymentRef    String?

  subtotal      Decimal       @db.Decimal(10, 2)
  deliveryFee   Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)

  deliveryNotes String?       @db.Text

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items         OrderItem[]

  @@index([userId])
  @@index([status])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  MPESA
  CARD
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int
  unitPrice Decimal         @db.Decimal(10, 2)

  @@index([orderId])
}

// ---------- REVIEWS ----------

model Review {
  id                 String   @id @default(cuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  rating             Int
  title              String?
  body               String?  @db.Text
  isVerifiedPurchase Boolean  @default(false)
  createdAt          DateTime @default(now())

  @@index([productId])
}

model Review {
  id         String   @id @default(cuid())
  rating     Int
  authorName String
  comment    String
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id])
  productId  String
}